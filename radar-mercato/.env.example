# Copia questo file in .env e riempi solo quello che hai.
# Tutte le fonti qui sotto hanno un piano gratuito.

# Alpaca (prezzo/volume, feed IEX gratuito) - registrazione gratuita su alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# User-Agent richiesto da SEC EDGAR per il polling (mettici la tua email, come richiesto da sec.gov/os/webmaster-faq)
SEC_EDGAR_USER_AGENT="Nome Cognome tuo@email.it"

# Titoli da seguire all'avvio, separati da virgola (puoi cambiarli dalla dashboard dopo)
WATCHLIST_DEFAULT=AAPL,TSLA,GME,NVDA,AMC,PLTR,SOFI,RIVN

# Percorso del database SQLite (va bene il default per il test gratuito)
DATABASE_URL=sqlite:///./radar.db

# Ogni quanti minuti girano i job di raccolta dati + scoring
POLL_INTERVAL_MINUTES=15

# Origine consentita per il frontend in sviluppo
CORS_ORIGIN=http://localhost:5173
